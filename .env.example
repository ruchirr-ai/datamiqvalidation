# AWS Configuration
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=123456789012

# KMS Encryption Configuration (Production)
# The KMS key ID is stored in AWS Secrets Manager and fetched on each encrypt/decrypt operation
ENCRYPTION_SECRET_NAME=datamiq/encryption/kms-key-id
ENCRYPTION_AWS_REGION=us-east-1

# Legacy: KMS Key Configuration (for reference only - actual key ID stored in Secrets Manager)
KMS_KEY_ID=arn:aws:kms:us-east-1:123456789012:key/12345678-1234-1234-1234-123456789012
KMS_KEY_ALIAS=alias/db-migrator-key

# Secrets Manager Configuration
SECRET_MANAGER_SECRET_NAME=db-migrator/encryption-key
SECRET_MANAGER_REGION=us-east-1

# Application Database (PostgreSQL)
APP_DB_HOST=localhost
APP_DB_PORT=5432
APP_DB_NAME=db_migrator
APP_DB_USER=db_migrator_user
APP_DB_PASSWORD=change_me_in_production
APP_DB_SSL_MODE=require

# Database Connection Pool
DB_POOL_SIZE=20
DB_POOL_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30

# Redis Cache Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=change_me_in_production
REDIS_SSL=false
REDIS_MAX_CONNECTIONS=50
REDIS_SOCKET_TIMEOUT=5
REDIS_SOCKET_CONNECT_TIMEOUT=5
REDIS_ENABLED=true

# Microservices Configuration
AUTH_SERVICE_URL=http://localhost:8001
CONNECTION_SERVICE_URL=http://localhost:8002
ASSESSMENT_SERVICE_URL=http://localhost:8003
MIGRATION_SERVICE_URL=http://localhost:8004
MONITORING_SERVICE_URL=http://localhost:8005
VALIDATION_SERVICE_URL=http://localhost:8006

# Application Configuration
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
LOG_LEVEL=INFO

# Security
JWT_SECRET_KEY=change_me_in_production_use_long_random_string
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# Migration Configuration
MIGRATION_BATCH_SIZE=1000
MIGRATION_MAX_WORKERS=4
MIGRATION_TIMEOUT_SECONDS=3600

# Monitoring
ENABLE_METRICS=true
METRICS_INTERVAL_SECONDS=60

# CloudWatch Configuration
CLOUDWATCH_LOG_GROUP=/aws/db-migrator
CLOUDWATCH_LOG_STREAM=backend

# S3 Configuration (for backups)
S3_BACKUP_BUCKET=db-migrator-backups
S3_BACKUP_PREFIX=backups/

# Feature Flags
ENABLE_VALIDATION=true
ENABLE_MONITORING=true
ENABLE_AUDIT_LOGGING=true

# Admin User Setup (for initial setup script)
ADMIN_USER=admin
ADMIN_PASSWORD=change_me_in_production
