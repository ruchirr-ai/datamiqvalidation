# Application Database (PostgreSQL)
APP_DB_HOST=localhost
APP_DB_PORT=5432
APP_DB_NAME=datamiq
APP_DB_USER=postgres
APP_DB_PASSWORD=your_password_here
APP_DB_SSL_MODE=disable
 
# Database Connection Pool
DB_POOL_SIZE=20
DB_POOL_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
 
# Redis Cache Configuration
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
 
# Application Configuration
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
LOG_LEVEL=INFO
 
# Security
JWT_SECRET_KEY=change_this_to_a_secure_random_string_in_production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60
 
# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8000
 
# Admin User Setup
ADMIN_USER=admin
ADMIN_PASSWORD=change_this_password
 
# AWS Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
 
# Feature Flags
ENABLE_VALIDATION=true
ENABLE_MONITORING=true
ENABLE_AUDIT_LOGGING=true

# Claude AI Configuration (Anthropic API - Recommended)
ANTHROPIC_API_KEY=your_claude_api_key_here
CLAUDE_MODEL=claude-3-5-sonnet-20241022
CLAUDE_MAX_TOKENS=4096
CLAUDE_TEMPERATURE=0.7

# AWS Bedrock Configuration (Alternative to Anthropic API)
CLAUDE_USE_BEDROCK=false
CLAUDE_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0

# AWS Bedrock Configuration for SQL Conversion
# Region where Bedrock service is available
AWS_BEDROCK_REGION=us-east-1
# Default model for SQL conversion (Claude v2 or newer)
AWS_BEDROCK_DEFAULT_MODEL=anthropic.claude-v2
# Rate limit per workspace per hour to control costs
BEDROCK_RATE_LIMIT_PER_WORKSPACE_HOUR=100

# Conversion Service Configuration
# Directory containing prompt templates for SQL conversion
CONVERSION_PROMPT_TEMPLATES_DIR=backend/prompts
# Maximum retry attempts for failed conversions
CONVERSION_MAX_RETRIES=3
# Number of parallel jobs to process in batch conversions
CONVERSION_BATCH_PARALLELISM=5

# AWS DataSync Configuration
# Region for DataSync service
AWS_DATASYNC_REGION=us-east-1
# IAM Role ARN to assume for DataSync API calls (via STS AssumeRole)
DATASYNC_ROLE_ARN=arn:aws:iam::123456789012:role/DataSyncRole
# Interval (seconds) to check agent health status
DATASYNC_AGENT_HEALTH_CHECK_INTERVAL_SECONDS=300

# History Tracking Configuration
# Cache TTL for copy history records (5 minutes)
COPY_HISTORY_CACHE_TTL_SECONDS=300
# Cache TTL for task history records (1 minute for active tasks)
TASK_HISTORY_CACHE_TTL_SECONDS=60
# Default page size for history list endpoints
HISTORY_DEFAULT_PAGE_SIZE=50
# Maximum page size for history list endpoints
HISTORY_MAX_PAGE_SIZE=200

# Redis Configuration (Enhanced)
# Redis password (leave empty if no password)
REDIS_PASSWORD=
# Enable SSL/TLS for Redis connections (recommended for production)
REDIS_SSL=false
# Maximum number of connections in the pool
REDIS_MAX_CONNECTIONS=50
# Socket timeout in seconds
REDIS_SOCKET_TIMEOUT=5
# Socket connect timeout in seconds
REDIS_SOCKET_CONNECT_TIMEOUT=5
